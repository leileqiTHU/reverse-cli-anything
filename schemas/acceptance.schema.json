{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-adapter acceptance checklist and command coverage",
  "type": "object",
  "required": [
    "schemaVersion",
    "adapter",
    "build",
    "checklist",
    "tools"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "adapter": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "build": {
      "type": "string",
      "minLength": 1
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "assertion"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "coverage",
          "evidence",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "coverage": {
            "enum": [
              "current-native",
              "historical-workflow",
              "not-run"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "coverage": {
                  "enum": [
                    "current-native",
                    "historical-workflow"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
