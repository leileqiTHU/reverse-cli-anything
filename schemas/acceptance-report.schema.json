{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target-independent workflow evidence report",
  "type": "object",
  "required": ["schemaVersion", "adapter", "target", "workflow", "checks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "target": {"type": "object", "required": ["name", "build"], "properties": {"name": {"type": "string"}, "build": {"type": "string"}}},
    "workflow": {"type": "string"},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["layer", "name", "status"],
        "properties": {
          "layer": {"enum": ["request", "state", "persistence", "artifact", "recovery"]},
          "name": {"type": "string"},
          "status": {"enum": ["passed", "failed", "not-run", "not-applicable"]},
          "reason": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
        }
      }
    }
  }
}
