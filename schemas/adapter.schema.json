{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reverse-cli-anything adapter manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "entrypoint", "toolSchema"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "name": {"type": "string"},
    "root": {"type": "string"},
    "entrypoint": {"type": "string"},
    "toolSchema": {"type": "string"},
    "runtime": {"type": "string"},
    "skill": {"type": "string"},
    "acceptance": {"type": "string"},
    "testedBuilds": {"type": "array", "items": {"type": "string"}}
  }
}
